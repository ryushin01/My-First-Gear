{
  "name": "shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "dev:db": "node ../../packages/db/scripts/with-db.mjs --persist .local-db -- next dev --port 3000",
    "start:db": "node ../../packages/db/scripts/with-db.mjs -- next start",
    "test": "vitest run",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@mfg/catalog": "workspace:*",
    "@mfg/db": "workspace:*",
    "@mfg/gear-art": "workspace:*",
    "@mfg/hooks": "workspace:*",
    "@sentry/browser": "^11.12.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@unocss/postcss": "66.12.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "typescript": "^5",
    "unocss": "66.12.0",
    "vite": "8.3.7",
    "vitest": "^4.1.12"
  }
}
